# Victory Video Studio — environment configuration.
#
# Copy this file to server/.env (NOT committed — .gitignore excludes every .env file) and fill
# in what you have. The app runs with nothing filled in beyond the first three: Diagnostics will
# just show every integration as "not configured" until you add its credentials, and the
# Diagnostics page's Test Connection button is the way to confirm each one actually works before
# trusting it with a real course. See /INTEGRATIONS.md for where to get each credential and what
# permissions it needs.

# --- Core (required) -------------------------------------------------------------------------

# SQLite by default. The path is resolved relative to server/prisma/schema.prisma's directory,
# NOT your shell's working directory — "file:../data/victory.db" puts the database at
# server/data/victory.db, matching STORAGE_ROOT below. See DEPLOYMENT.md if you want Postgres
# instead (one-line change in server/prisma/schema.prisma).
DATABASE_URL="file:../data/victory.db"

# Where uploaded documents, rendered slides/video/audio, and brand assets are stored. Resolved
# relative to the server process's working directory (normally the server/ directory itself).
STORAGE_ROOT=./data

# A long, random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared admin password gating the whole app. Leave unset for local development (no login
# screen); set it before exposing a deployment to the internet — see DEPLOYMENT.md's security
# checklist.
ADMIN_PASSWORD=

# Where the Python rendering engine lives, relative to the server/ directory.
ENGINE_DIR=../engine
# Python binary to fall back to if engine/.venv isn't present (the server prefers the venv
# interpreter automatically when it exists).
PYTHON_BIN=python3

PORT=4000
NODE_ENV=development

# Set to "true" only on a host that runs a single process per app (e.g. Cloudways' Node.js app
# type) — this runs the job-queue worker's poll loop inside the API process instead of as a
# separate process. Leave unset/false if you're running server/src/queue/worker.ts as its own
# process (the default two-process setup in DEPLOYMENT.md). See DEPLOYMENT.md's
# "Single-process hosts" section.
RUN_WORKER_INLINE=false

# --- ElevenLabs (narration) -------------------------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- AWS S3 (video/resource storage) ----------------------------------------------------------
# An IAM user or role with s3:PutObject, s3:GetObject, s3:DeleteObject, and s3:ListBucket on the
# bucket(s) you'll use. AWS_DEFAULT_BUCKET is only a fallback for courses that haven't set their
# own bucket in Course Defaults.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_DEFAULT_BUCKET=

# --- Bunny Stream (video hosting/CDN) ----------------------------------------------------------
# https://dash.bunny.net/stream -> your library -> API
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
# Only needed if your pull zone hostname doesn't follow Bunny's default vz-<library-id>.b-cdn.net
# pattern.
BUNNY_CDN_HOSTNAME=

# --- Moodle (publishing) -----------------------------------------------------------------------
# A Moodle web services token with at least: core_webservice_get_site_info,
# core_course_edit_section, core_course_edit_module. See INTEGRATIONS.md for how to create one.
MOODLE_BASE_URL=https://your-moodle-site.example.com
MOODLE_TOKEN=

# --- Optional AI assist (lesson description suggestions only — never required) -----------------
AI_PROVIDER=anthropic
AI_API_KEY=
